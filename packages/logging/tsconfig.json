    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "types": [
      "node"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
